{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maichicong835/A-Ver/spec/request.schema.json",
  "title": "A-Ver Trademark Request v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "request_id",
    "wording",
    "intended_goods_context",
    "requested_scope"
  ],
  "properties": {
    "schema": {"const": "AVER_TM_REQUEST"},
    "schema_version": {"const": "1.0"},
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "wording": {"type": "string", "minLength": 1, "maxLength": 300},
    "intended_goods_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_class", "description"],
      "properties": {
        "primary_class": {"type": "string", "pattern": "^[0-9]{3}$"},
        "coordinated_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9]{3}$"}
        },
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "channels": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "purchasers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    },
    "requested_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "federal_registry", "related_goods_review", "query_dimensions"],
      "properties": {
        "country": {"const": "US"},
        "federal_registry": {"const": true},
        "related_goods_review": {"const": true},
        "query_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "EXACT",
              "NORMALIZED_EXACT",
              "CORE_DOMINANT_TOKEN",
              "EXPANDED_PARTIAL",
              "PHONETIC_OR_SPELLING_WHEN_MATERIAL",
              "RELATED_GOODS_REVIEW"
            ]
          }
        }
      }
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {"type": "string", "minLength": 1, "maxLength": 120},
        "reference": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
