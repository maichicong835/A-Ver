        "failed_component": "TRADEMARKIA_OPAQUE_ZERO_QUERY_BINDING",
        "observed_cause": "PRE_SUBMIT_INPUT_VALUE_EMPTY"
      },
      "repair_contract": {
        "stable_query_binding_before_submit_required": true,
        "stable_binding_observations_min": 2,
        "bounded_rebind_attempts_max": 3,
        "if_binding_unstable": "CAPABILITY_UNPROVEN_WITH_PRECISE_FAILURE_SIGNATURE",
