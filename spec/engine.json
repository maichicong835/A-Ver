  "scope_completeness_law": {
    "full_site_ui_feature_coverage_is_not_equal_to_tm_safety_scope": true,
    "production_may_use_only_declared_machine_proven_resolver_capabilities": true,
    "required_tm_query_plan_must_still_be_complete": true,
