{
  "schema": "AVER_TM_ENGINE",
  "engine": "A-Ver Trademark Verification Engine",
  "engine_version": "0.1.0",
  "mode": "ACCEPTANCE_ONLY",
  "authority": {
    "repository": "maichicong835/A-Ver",
    "branch": "main",
    "current": "CURRENT.json",
    "caller_inputs_are_data_only": true,
    "caller_policy_is_not_inherited": true,
    "workflow_orchestration_is_not_a_second_spec": true
  },
  "truth_layers": [
    "TRANSPORT_TRUTH",
    "QUERY_EXECUTION_TRUTH",
    "RESULTSET_TRUTH",
    "RECORD_BINDING_TRUTH",
    "SCOPE_COVERAGE_TRUTH",
    "SIMILARITY_ANALYSIS_TRUTH",
    "GOODS_RELATEDNESS_TRUTH",
    "TM_DECISION_TRUTH"
  ],
  "state_machine": {
    "capability_states": [
      "CAPABILITY_NOT_TESTED",
      "TRANSPORT_PASS",
      "TRANSPORT_BLOCKED",
      "QUERY_EXECUTION_PASS",
      "QUERY_EXECUTION_BLOCKED",
      "RESULTSET_RESOLVED",
      "RESULTSET_UNRESOLVED",
      "RECORD_BINDING_PASS",
      "RECORD_BINDING_INCOMPLETE",
      "NEGATIVE_SEMANTICS_PROVEN",
      "NEGATIVE_SEMANTICS_UNPROVEN",
      "CAPABILITY_ACCEPTED",
      "CAPABILITY_EXCLUDED_UNPROVEN"
    ],
    "tm_decision_states": ["TM_PASS", "TM_KILL", "TM_HOLD"],
    "acceptance_mode_may_emit_tm_decision_states": false,
    "capability_state_may_be_mapped_directly_to_tm_decision": false
  },
  "resolver_roles": {
    "TRADEMARKIA": {
      "role": "BROAD_US_FEDERAL_RECORD_RESOLVER",
      "behavior": "BROAD_RECALL_WITH_FUZZY_OR_TOKEN_EXPANSION_POSSIBLE",
      "accepted_capabilities": [
        "KNOWN_POSITIVE_SEARCH",
        "KNOWN_RECORD_BINDING",
        "BROAD_FUZZY_OR_TOKEN_RECALL",
        "OPAQUE_SINGLE_TOKEN_ZERO_SEMANTICS_WITH_LIMITED_MEANING"
      ],
      "query_submission_requires_stable_binding_attestation": true,
      "stable_binding_observation_count_min": 2,
      "stable_binding_attempts_max": 3,
      "opaque_zero_may_not_be_generalized_to_arbitrary_multi_token_exact_clearance": true,
      "required_material_record_fields_when_hit": [
        "mark_text",
        "status",
        "serial_or_registration_identifier",
        "class_or_goods_services_context"
      ]
    },
    "TMHUNT": {
      "role": "IC025_APPAREL_ADJACENT_RESOLVER",
      "declared_scope": "IC025",
      "scope_generalization_forbidden": true,
      "accepted_modes": ["EXACT", "PARTIAL"],
      "accepted_negative_semantics": ["EXACT_ZERO_WITHIN_IC025"],
      "excluded_unproven_modes": {
        "SPLIT": "CAPABILITY_EXCLUDED_UNPROVEN_ZERO_COVERAGE_WEIGHT",
        "WILDCARD": "CAPABILITY_EXCLUDED_UNPROVEN_ZERO_COVERAGE_WEIGHT"
      },
      "excluded_modes_have_zero_scope_coverage_weight": true,
      "same_strategy_retry_of_excluded_modes_forbidden": true
    },
    "USPTO_TSDR_WEB": {
      "role": "OPTIONAL_TARGETED_OFFICIAL_SPOT_VERIFIER",
      "requires_known_identifier": true,
      "not_required_for_base_fallback_transport": true
    }
  },
  "evidence_asymmetry": {
    "credible_positive_hit_can_escalate_review": true,
    "positive_material_hit_is_not_cancelled_by_another_resolver_negative": true,
    "negative_requires_resolved_native_resultset": true,
    "single_source_negative_is_never_legal_clearance": true,
    "search_engine_index_miss_has_zero_negative_clearance_weight": true,
    "transport_failure_has_zero_candidate_risk_weight": true,
    "resolver_negative_weight_is_bounded_by_machine_proven_scope": true,
    "excluded_capability_has_zero_coverage_weight": true,
    "unbound_query_has_zero_negative_clearance_weight": true
  },
  "query_plan": {
    "deterministic": true,
    "required_stages": [
      "EXACT",
      "NORMALIZED_EXACT",
      "CORE_DOMINANT_TOKEN",
      "EXPANDED_PARTIAL",
      "PHONETIC_OR_SPELLING_WHEN_MATERIAL",
      "RELATED_GOODS_REVIEW"
    ],
    "resolver_mode_and_query_stage_are_not_synonyms": true,
    "tmhunt_split_or_wildcard_is_not_required_if_required_query_stage_is_completed_by_an_authorized_resolver": true,
    "early_positive_stop_allowed": true,
    "negative_pass_requires_required_query_scope_complete": true,
    "missing_required_query_dimension": "TM_HOLD_EVIDENCE_NOT_TM_PASS"
  },
  "anti_loop": {
    "same_resolver_same_stage_same_failure_signature_max_retries": 1,
    "repair_only_observed_causal_dimension": true,
    "a4_repeatability_query_binding_repair_dimension": "STABLE_QUERY_BINDING_BEFORE_SUBMIT",
    "more_candidate_queries_may_not_answer_systemic_transport_failure": true,
    "more_candidate_queries_may_not_answer_mode_binding_failure": true,
    "more_candidate_queries_may_not_answer_repeatability_failure": true,
    "acceptance_breadth_is_fixed_canary_set_not_market_discovery": true,
    "successful_prior_layers_remain_closed": true,
    "authority_or_documentation_change_alone_does_not_reopen_closed_layers": true,
    "new_resolver_discovery_for_a4_repair_forbidden": true
  },
  "orchestration": {
    "closed_phase_auto_rerun_on_current_or_spec_change": false,
    "phase_auto_run_allowed_when_its_own_harness_or_shared_resolver_changes": true,
    "manual_workflow_dispatch_allowed": true,
    "isolated_repeatability_ref_creation_allowed_when_dispatch_tooling_is_unavailable": true,
    "repeatability_ref_must_point_to_same_exact_commit": true,
    "repeatability_via_content_change_or_noop_commit_forbidden": true,
    "authority_guard_is_separate_from_resolver_acceptance": true,
    "workflow_success_requires_semantic_profile_pass": true,
    "partial_semantic_receipt_must_be_uploaded_before_workflow_failure_when_receipt_exists": true
  },
  "shared_resolver_implementation": {
    "module_root": "src/aver/resolvers",
    "acceptance_a4_imports_shared_modules": true,
    "future_production_imports_same_modules": true,
    "parallel_resolver_implementation_forbidden": true
  },
  "acceptance": {
    "a0": {"status": "PASS_CLOSED", "purpose": "PROVE_GITHUB_RUNNER_PUBLIC_TRANSPORT_AND_SURFACE_IDENTITY"},
    "a1": {"status": "PASS_CLOSED", "purpose": "PROVE_KNOWN_POSITIVE_QUERY_AND_RECORD_BINDING"},
    "a2": {"status": "PASS_CLOSED", "purpose": "PROVE_NATIVE_QUERY_AND_RESULTSET_STRUCTURE"},
    "a3": {"status": "PASS_CLOSED", "purpose": "PROVE_ZERO_NO_MATERIAL_HIT_SEMANTICS_WITHOUT_SEARCH_ENGINE_INFERENCE"},
    "a4": {
      "purpose": "PROVE_REPEATABILITY_OF_FROZEN_DECLARED_CAPABILITY_PROFILE",
      "status": "REPEATABILITY_FAILED_QUERY_BINDING_STABILITY_REPAIR_PENDING",
      "profile_id": "AVER_TM_PROFILE_0_1_SCOPED",
      "fixed_canaries": ["NIKE", "QZXJVMRKPLN91372", "JUST DO IT", "AVER QZXJ KESTREL 91372", "50086105"],
      "tmhunt_modes_under_test": ["EXACT", "PARTIAL"],
      "tmhunt_excluded_modes_not_tested": ["SPLIT", "WILDCARD"],
      "trademarkia_behaviors_under_test": ["KNOWN_POSITIVE_SEARCH", "KNOWN_RECORD_BINDING", "OPAQUE_ZERO", "FUZZY_RECALL"],
      "latest_failed_pair": {
        "commit_sha": "2f2780cfe8038976c84f72478cbcd6af0ce223b4",
        "run_1": "34701480046_PASS",
